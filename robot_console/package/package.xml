<?xml version="1.0"?>
<package format="3">
  <name>rqt_robot_console</name>
  <version>0.1.0</version>
  <description>ZSL-1W mapping and patrol console with offline demonstration</description>
  <maintainer email="robot-console@example.com">Robot Console Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>qt_gui</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-websocket</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <export>
    <build_type>ament_python</build_type>
    <qt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
